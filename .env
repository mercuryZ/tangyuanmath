NODE_ENV=production
TM_DB_FILE=/data/app.db
TM_PUBLIC_BASE_URL=https://tangyuanmath.com
# 邮件通道：console（链接打进日志）或 cloudflare（Cloudflare Email Service REST API）
TM_MAIL_TRANSPORT=cloudflare
TM_MAIL_FROM=Tangyuan Math <no-reply@tangyuanmath.com>
# Cloudflare Email Service：账号 ID 与具备「Email Sending: Edit」权限的 API Token。
# 真实密钥只填在 Render 控制台 / 本地 .env.production，不要写进这个被 git 跟踪的文件。
TM_CF_ACCOUNT_ID=
TM_CF_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
