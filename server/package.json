{
  "name": "tangyuan-math-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tangyuan Math — Express + SQLite backend (M1: parent accounts & cloud learning data)",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test ../tests/*.test.js",
    "backup": "node scripts/backup.js now",
    "backup:list": "node scripts/backup.js list",
    "backup:verify": "node scripts/backup.js verify",
    "backup:prune": "node scripts/backup.js prune",
    "waffo:doctor": "node scripts/waffo-doctor.js",
    "revoke-launch-promo": "node scripts/revoke-launch-promo.js",
    "waffo:products": "node scripts/waffo-setup.js products",
    "waffo:list": "node scripts/waffo-setup.js list",
    "waffo:webhook": "node scripts/waffo-setup.js webhook",
    "waffo:publish": "node scripts/waffo-setup.js publish"
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@waffo/pancake-ts": "0.26.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "pdf-lib": "^1.17.1",
    "ws": "^8.22.0"
  }
}
